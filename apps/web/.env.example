# Next.js Configuration
_next_intl_trailing_slash=false

# API Configuration
NEXT_PUBLIC_API_URL=https://koptupbackend-production.up.railway.app

# Clave compartida con el backend (solo servidor, nunca NEXT_PUBLIC_). La usan
# el middleware que protege /admin y /dashboard y la ruta proxy de LinkedIn
# Ads para informar al backend la IP real del visitante (rate-limit por IP).
# Debe ser igual a INTERNAL_API_KEY del backend. Opcional: sin ella, el
# backend cuenta esas peticiones por la IP de salida del servidor de la web.
# INTERNAL_API_KEY=

# La generación de LinkedIn Ads ya no usa OPENAI_API_KEY en la web: vive en el
# backend (/api/linkedin-ads/generate) con su tope de gasto.

# AWS S3 (if needed)
# NEXT_PUBLIC_S3_BUCKET=koptup-uploads

# Medición para anuncios (opcional; ver "Variables de entorno" en el README).
# Cada etiqueta se carga solo si su variable existe Y el visitante acepta
# cookies (banner o /cookies). Son NEXT_PUBLIC_*: se fijan en el build; en
# Vercel hay que redesplegar después de cambiarlas. Vacías = no se cargan.
# GA4: ID de medición "G-XXXXXXXXXX" (cookies de analítica).
NEXT_PUBLIC_GA_ID=
# Google Ads: ID de la etiqueta "AW-XXXXXXXXX" (cookies de marketing).
NEXT_PUBLIC_GOOGLE_ADS_ID=
# LinkedIn Insight Tag: Partner ID numérico (cookies de marketing).
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
