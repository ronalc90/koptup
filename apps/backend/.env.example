# ==============================================
# KopTup backend — variables de entorno (solo nombres y valores de ejemplo).
# Nunca pongas valores reales en este archivo: el repositorio es público.
# Al arrancar, src/config/env.ts valida estas variables con zod:
#   - En producción el servidor NO arranca si falta MONGODB_URI, JWT_SECRET o
#     JWT_REFRESH_SECRET.
#   - Las opcionales que faltan solo generan una advertencia en el log.
# ==============================================

# ==============================================
# SERVIDOR
# ==============================================
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
# URL pública de la web (enlaces de correos y del generador de LinkedIn).
FRONTEND_URL=http://localhost:3000
# Proxies delante del backend (Railway = 1). Define req.ip, que usan los rate
# limiters y los cupos por IP de las demos con IA.
TRUST_PROXY_HOPS=1
# Documentación interactiva /api-docs: siempre fuera de producción; en
# producción solo si vale true (no la actives en el entorno público).
API_DOCS_ENABLED=false

# ==============================================
# BASE DE DATOS (obligatoria en producción)
# ==============================================
MONGODB_URI=mongodb://localhost:27017/koptup_db
# MongoDB Atlas: mongodb+srv://<usuario>:<contraseña>@<cluster>/<base>

# ==============================================
# CORS
# ==============================================
# Orígenes extra separados por coma (koptup.com y www.koptup.com siempre se permiten).
CORS_ORIGIN=http://localhost:3000

# ==============================================
# AUTENTICACIÓN (obligatorias en producción; valores largos y aleatorios, distintos entre sí)
# ==============================================
JWT_SECRET=change-me-min-32-random-characters
JWT_REFRESH_SECRET=change-me-another-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Opcional: si se define, al arrancar se asegura el rol admin de esa cuenta
# (solo si ya existe). Sin esta variable el arranque no modifica roles.
# ADMIN_EMAIL=
# Opcional: clave compartida entre la web (Vercel) y el backend para que el
# middleware de Next (/admin, /dashboard) y la ruta proxy
# /api/linkedin-ads/generate informen la IP real del visitante (límites por
# IP). Debe ser igual en ambos entornos.
# INTERNAL_API_KEY=

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ==============================================
# ARCHIVOS
# ==============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,txt,csv
# Carpeta de la que el admin puede importar CUPS (solo nombres de archivo).
CUPS_IMPORT_DIR=./data/imports

# AWS S3 (opcional)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ==============================================
# REDIS (sesiones de refresco, rate-limit y topes de gasto de IA)
# ==============================================
REDIS_URL=redis://localhost:6379
# Railway Redis: redis://default:<contraseña>@<host>:6379
# Sin Redis conectado, las funciones de IA públicas (prueba con tu documento,
# generador de LinkedIn, gestor de contenido) quedan apagadas y el chatbot
# responde en modo extractivo: no se puede medir el gasto.

# Límite general de la API por IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# IA (OpenAI)
# ==============================================
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini
# Solo para pruebas locales o CI con un servidor compatible (mock).
# OPENAI_BASE_URL=http://127.0.0.1:3999/v1

# Topes de gasto mensual en USD (mes UTC, acumulado en Redis con los tokens
# que informa OpenAI). Al alcanzarlos, la función se apaga hasta el mes siguiente.
# Demo "Prueba con tu documento" (/api/demo-rag). Por defecto 50.
DEMO_MONTHLY_BUDGET_USD=50
# Chatbot: Builder, Playground y chat por sesión (/api/chatbot). Por defecto 50.
CHATBOT_MONTHLY_BUDGET_USD=50
# Generador de LinkedIn Ads (/api/linkedin-ads/generate). Por defecto 20.
LINKEDIN_ADS_MONTHLY_BUDGET_USD=20
# Gestor de contenido con IA (/api/content). Por defecto 20.
CONTENT_MONTHLY_BUDGET_USD=20

# ==============================================
# DEMO "PRUEBA CON TU DOCUMENTO" (/demo/chatbot → /api/demo-rag)
# ==============================================
# Encendido explícito. Funciona solo si DEMO_UPLOAD_ENABLED=true, Redis está
# conectado y existe OPENAI_API_KEY.
DEMO_UPLOAD_ENABLED=false
# Solo para pruebas locales: baja el TTL de 1 hora de los documentos (en
# segundos). Se ignora con NODE_ENV=production. No la definas en Railway.
# DEMO_RAG_TTL_SECONDS=60

# ==============================================
# CHATBOT (/api/chatbot/bots)
# ==============================================
# IDs de bots de ejemplo visibles para todos en GET /bots (separados por coma).
# CHATBOT_EXAMPLE_BOT_IDS=
# Carpeta del estado en disco del chatbot (por defecto ./data/chatbots).
# CHATBOT_STATE_DIR=

# ==============================================
# EMAIL (SMTP) Y WHATSAPP (opcionales)
# ==============================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# WHATSAPP_PROVIDER=
# ADMIN_WHATSAPP_NUMBER=

# ==============================================
# SISTEMA DE DEMOS (solicitud, aprobación y acceso)
# ==============================================
# Los correos (acuse, aprobación con enlace de activación, recordatorio de
# vencimiento) usan el SMTP de arriba. Sin SMTP no se envía nada y el panel
# muestra siempre el enlace de activación para compartirlo por otro medio.
# Los enlaces apuntan a FRONTEND_URL (/activar/<token>, /dashboard/demos).
# Versión de la política de tratamiento de datos que se guarda con cada
# autorización (Ley 1581). Por defecto 2026-10.
# PRIVACY_POLICY_VERSION=2026-10
# Cupos del formulario "Solicitar demo" (POST /api/demo-requests).
# DEMO_REQUEST_LIMIT_PER_HOUR=5
# DEMO_REQUEST_LIMIT_PER_EMAIL_DAY=3
# Job de vencimiento de accesos y recordatorio 3 días antes (candado en
# Redis para no correr dos veces con varias instancias). Por defecto cada hora.
# DEMO_GRANTS_JOB_ENABLED=true
# DEMO_GRANTS_JOB_INTERVAL_MS=3600000

# ==============================================
# SEMILLAS (solo desarrollo; nunca en producción)
# ==============================================
# Si no se definen, se genera una contraseña aleatoria y se muestra en consola.
SEED_ADMIN_PASSWORD=change-me-admin-dev
SEED_CLIENT_PASSWORD=change-me-client-dev
